.DS_Store

# Xcode user state
xcuserdata/
*.xcuserstate
*.xccheckout
*.xcscmblueprint

# Sparkle signing material (must stay outside the repository)
*Sparkle-private-key*

# Build and test output
build/
DerivedData/
dist/
*.xcresult

# Swift Package Manager
.build/
.swiftpm/xcode/package.xcworkspace/xcuserdata/

# 词库构建输入：原始 ECDICT 数据体积大且可重新取得，不进入仓库
.lexicon-source/

# Sparkle 生成物：正式 appcast 只提交 updates/appcast.xml（GitHub Pages 源）
SparkleReleases/appcast.xml

# 前端视觉参考稿：docs 下的 html 仅用于本地预览效果，不进入仓库
docs/**/*.html

# 发布产物：zip 只上传到 GitHub Release，不入库（19 MB 二进制，对更新链无用）
SparkleReleases/*.zip
