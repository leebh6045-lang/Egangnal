      "expected": "apple"
    },
    {
      "input": "  apple  ",
      "expected": "apple"
    },
    {
      "input": "New   York",
      "expected": "new york"
    },
    {
      "input": "New\tYork",
      "expected": "new york"
    },
    {
      "input": "long-time",
      "expected": "long-time"
    },
    {
      "input": "don't",
      "expected": "don't"
    },
    {
      "input": "café",
      "expected": "café"
    },
    {
      "input": "café",
      "expected": "café"
    },
    {
      "input": "Über",
      "expected": "über"
    },
    {
      "input": "naïve",
      "expected": "naïve"
    },
    {
      "input": "co-operate",
      "expected": "co-operate"
    },
    {
      "input": "ABANDON",
      "expected": "abandon"
    },
    {
      "input": "a",
      "expected": "a"
    },
    {
      "input": "",
      "expected": ""
    },
    {
      "input": "   ",
      "expected": ""
    },
    {
      "input": "ＦｕｌｌＷｉｄｔｈ",
      "expected": "ｆｕｌｌｗｉｄｔｈ"
